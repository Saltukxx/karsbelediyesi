# Veritabanı
DATABASE_URL="postgresql://kars:kars_dev_sifre@localhost:5432/kars_belediyesi"
# Web örneği başına açılacak bağlantı sayısı (varsayılan 10). PostgreSQL
# max_connections değerini örnek sayısına bölerek belirleyin.
DB_CONNECTION_LIMIT="10"

# Redis (BullMQ kuyruk + WhatsApp oturum durumu)
REDIS_URL="redis://localhost:6379"

# Auth.js
AUTH_SECRET="degistir-uzun-rastgele-bir-anahtar"
AUTH_URL="http://localhost:3000"

# Mobil JWT
JWT_SECRET="degistir-mobil-jwt-anahtari"

# Gemini API (WhatsApp mesaj sınıflandırma + fine-tune)
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.5-flash"
# Few-shot count from gold.jsonl (fine-tune yok). Varsayılan 12.
GEMINI_FEW_SHOT="12"
# Fine-tune job bitince doldurun (örn. tunedModels/kars-sikayet-xxx)
GEMINI_TUNED_MODEL=""

# WhatsApp botu
WHATSAPP_AUTO_CONFIDENCE_THRESHOLD="0.75"

# Dosya yükleme dizini
UPLOAD_DIR="./uploads"

# Mobiliz araç takip (token gelince doldurun — yokken sync no-op)
MOBILIZ_TOKEN=""
MOBILIZ_BASE_URL="https://api.mobiliz.com.tr/api"
# Sync aralığı (ms) — cron veya throttle
MOBILIZ_SYNC_INTERVAL="60000"

# Cron koruması (sla-tarama / arac-suresi-tarama / sapma-tarama / mobiliz-sync)
CRON_SECRET=""


# --- Üretim (docker-compose.prod.yml) — geliştirmede gerekmez ---
# POSTGRES_USER="kars"
# POSTGRES_PASSWORD=""   # zorunlu; varsayılan yok
# POSTGRES_DB="kars_belediyesi"
# REDIS_PASSWORD=""      # zorunlu; varsayılan yok
# WEB_PORT="3000"

# Apple Push (APNs) — .p8 Key ID / Team ID doluysa gerçek gönderim; yoksa no-op + log
# Örnek anahtar yolu (makinede varsa): .../gbsoft-internal-backend/AuthKey_APNS.p8
APNS_KEY_PATH=""
APNS_KEY_ID=""
APNS_TEAM_ID=""
APNS_TOPIC="tr.gov.kars.panel"
# TestFlight/sandbox için boş bırakın; üretimde 1
APNS_PRODUCTION=""
